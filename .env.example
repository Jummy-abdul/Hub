# Sanity connection for the documentation website (server side only).
# Copy to .env.local for local development, or add these in Vercel:
# Project → Settings → Environment Variables.

SANITY_PROJECT_ID=idpyt5ut
SANITY_DATASET=fixiam_docs_sandbox

# Optional. Defaults to 2025-02-19.
# SANITY_API_VERSION=2025-02-19

# Only needed if the dataset is PRIVATE. Use a token with Viewer (read-only)
# permission. Never commit a real token.
# SANITY_API_READ_TOKEN=
