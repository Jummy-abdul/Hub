{
  "name": "fixiam-docs-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Sanity Studio for Fixiam Documentation",
  "type": "module",
  "main": "package.json",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "schema:validate": "sanity schema validate",
    "typecheck": "tsc --noEmit",
    "seed:build": "node seed/build-seed.mjs",
    "seed:check": "sanity exec seed/check-seed.ts",
    "seed:import": "npm run seed:build && npm run seed:check && node seed/import.mjs",
    "seed:import:replace": "npm run seed:build && npm run seed:check && node seed/import.mjs --replace"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.3",
    "@sanity/vision": "^6.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.17.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "node-html-parser": "^7.1.0",
    "typescript": "^5.9.3"
  }
}
